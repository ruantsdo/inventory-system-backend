# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
NODE_ENV=development
PORT=3333

# ──────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ──────────────────────────────────────────
# Cache / Queue Broker (Redis)
# ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────
# Minimum 32-char random string for HMAC signing
JWT_SECRET=change_me_to_a_random_32_char_min_string

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES=15m

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES=7d

# ──────────────────────────────────────────
# Cookie
# ──────────────────────────────────────────
# Secret used to sign cookies (cookie-parser)
COOKIE_SECRET=change_me_cookie_secret

# ──────────────────────────────────────────
# CORS
# ──────────────────────────────────────────
# URL of the frontend (e.g. http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────
# Observability
# ──────────────────────────────────────────
# Leave empty to disable Sentry
SENTRY_DSN=

# ──────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_MAX=100
# Window in milliseconds (default: 15 min)
RATE_LIMIT_WINDOW_MS=900000
