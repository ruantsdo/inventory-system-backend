generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum MovementType {
  RECEIPT
  SUPPLY
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  CONSUMPTION
  RESERVATION
  RELEASE
}

enum BatchStatus {
  OPEN
  QUARANTINED
  RELEASED
  CONSUMED
  EXPIRED
}

enum RequestType {
  REPLENISH
  URGENT
  ONE_TIME
}

enum RequestStatus {
  PENDING
  APPROVED
  FULFILLED
  CANCELLED
  REJECTED
}

enum PermissionScopeMode {
  GLOBAL
  FACILITY
  OWN
}

enum UserRoleScopeMode {
  GLOBAL
  FACILITY_SET
}

enum RoleCategory {
  FUNCTIONAL
  ADMINISTRATIVE
}

enum GovernanceLevel {
  ROOT
  SUPER_ADMIN
  SYSTEM_ADMIN
  MANAGER
}

enum ProfessionalDocumentType {
  CRM
  CRMV
  CRO
  COREN
  CREFITO
  CREF
  CRP
  CRA
  CREA
  CAU
  OAB
  RQE
  OTHER
}

//////////////////////////////////////////////////////
// CORE REFERENCE
//////////////////////////////////////////////////////

model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  state     String?
  country   String   @default("BR")

  isDeleted     Boolean   @default(false)
  deletedAt     DateTime? @db.Timestamptz
  deletedByUserId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  facilities    Facility[]
  suppliers     Supplier[]
  manufacturers Manufacturer[]

  @@index([name])
  @@index([state])
}

//////////////////////////////////////////////////////
// USERS / RBAC
//////////////////////////////////////////////////////

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String
  email        String   @unique
  cpf          String  @unique
  phone        String?
  passwordHash String
  isActive     Boolean  @default(false)
  birthDate    DateTime @db.Date

  zipCode         String?
  streetAddress   String?
  number          String?
  additionalInfo  String?
  neighborhood    String?
  addressCity     String?
  state           String?


  requestsMade           ItemRequest[]              @relation("requests_made")
  requestsResponsible    ItemRequest[]              @relation("requests_responsible")
  requestStatusChanges    ItemRequestStatusHistory[] @relation("request_status_changed_by")
  assignedUserRoles       UserRole[]                 @relation("UserRoleAssignedBy")
  performedMovements      StockMovement[]            @relation("StockMovementPerformedBy")

  // Soft delete
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime? @db.Timestamptz
  deletedByUserId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  roles UserRole[]
  professionalDocuments UserProfessionalDocument[]

  @@index([email])
  @@index([isActive])
}

model UserProfessionalDocument {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @db.Uuid
  documentType ProfessionalDocumentType
  documentNumber String
  issuer       String?
  issuerState  String?
  issuedAt     DateTime?               @db.Date
  expiresAt    DateTime?               @db.Date
  isPrimary    Boolean                 @default(false)
  isActive     Boolean                 @default(true)
  notes        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  isDeleted       Boolean   @default(false)
  deletedAt       DateTime? @db.Timestamptz
  deletedByUserId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([userId, documentType, documentNumber])
  @@index([userId])
  @@index([documentType])
  @@index([documentNumber])
  @@index([isActive])
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  displayName String
  description String?

  category RoleCategory

  governanceLevel GovernanceLevel?

  isProtected Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique
  displayName String
  description String?
  scopeMode   PermissionScopeMode @default(FACILITY)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid

  userId  String @db.Uuid
  roleId  String @db.Uuid

  scopeMode  UserRoleScopeMode @default(FACILITY_SET)
  isActive   Boolean           @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedByUserId String? @db.Uuid
  assignedByUser    User?   @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  facilities UserRoleFacilityScope[]

  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz
  assignedAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([roleId])
  @@index([scopeMode])
  @@unique([userId, roleId, scopeMode])
}

model UserRoleFacilityScope {
  id         String @id @default(uuid()) @db.Uuid
  userRoleId  String @db.Uuid
  facilityId  String @db.Uuid

  userRole UserRole @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([userRoleId, facilityId])
  @@index([facilityId])
  @@index([userRoleId])
}

//////////////////////////////////////////////////////
// FACILITIES
//////////////////////////////////////////////////////

model Facility {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  cnes        String? @unique
  address     Json?
  phone       String?
  isActive    Boolean @default(true)

  cityId String? @db.Uuid
  city   City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)

  isDeleted       Boolean   @default(false)
  deletedAt       DateTime? @db.Timestamptz
  deletedByUserId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  locations      Location[]
  inventory      InventoryEntry[]
  movements      StockMovement[]
  itemRequests   ItemRequest[]
  userRoleScopes UserRoleFacilityScope[]

  @@index([cityId])
  @@index([isActive])
  @@index([name])
}

model Location {
  id          String  @id @default(uuid()) @db.Uuid
  facilityId  String  @db.Uuid
  code        String
  name        String?
  description String?
  isActive    Boolean @default(true)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  isDeleted       Boolean   @default(false)
  deletedAt       DateTime? @db.Timestamptz
  deletedByUserId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  inventory    InventoryEntry[]
  movements    StockMovement[]
  itemRequests ItemRequest[]

  @@unique([facilityId, code])
  @@index([facilityId])
  @@index([isActive])
}

//////////////////////////////////////////////////////
// SUPPLY CHAIN
//////////////////////////////////////////////////////

model Manufacturer {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  cnpj      String?
  contact   Json?
  cityId    String? @db.Uuid
  city      City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  isDeleted       Boolean   @default(false)
  deletedAt       DateTime? @db.Timestamptz
  deletedByUserId String?   @db.Uuid

  items Item[]

  @@index([name])
  @@index([cityId])
  @@index([cnpj])
}

model Supplier {
  id                  String  @id @default(uuid()) @db.Uuid
  name                String
  cnpj                String?
  contact             Json?
  cityId              String? @db.Uuid
  city                City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  defaultLeadTimeDays  Int?
  createdAt           DateTime @default(now()) @db.Timestamptz
  updatedAt           DateTime @updatedAt @db.Timestamptz

  isDeleted       Boolean   @default(false)
  deletedAt       DateTime? @db.Timestamptz
  deletedByUserId String?   @db.Uuid

  @@index([name])
  @@index([cityId])
  @@index([cnpj])
}

//////////////////////////////////////////////////////
// ITEMS
//////////////////////////////////////////////////////

model ItemType {
  id               String @id @default(uuid()) @db.Uuid
  slug             String @unique
  title            String
  description      String?
  attributesSchema Json?

  isDeleted       Boolean   @default(false)
  deletedAt       DateTime? @db.Timestamptz
  deletedByUserId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  items Item[]

  @@index([slug])
  @@index([title])
}

model Item {
  id                String   @id @default(uuid()) @db.Uuid
  identifier        String   @unique
  gtin              String?  @unique
  name              String
  description       String?
  itemTypeId        String?  @db.Uuid
  itemType          ItemType? @relation(fields: [itemTypeId], references: [id], onDelete: SetNull)
  unitOfMeasurement String
  unitSize          Decimal? @db.Decimal(14, 4)
  isActive          Boolean  @default(true)
  attributes        Json?

  manufacturerId String?       @db.Uuid
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)

  // Soft delete
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime? @db.Timestamptz
  deletedByUserId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  version   Int      @default(1)

  batches    Batch[]
  inventory  InventoryEntry[]
  movements  StockMovement[]
  requests   ItemRequest[]

  @@index([name])
  @@index([itemTypeId])
  @@index([manufacturerId])
}

model Batch {
  id                String @id @default(uuid()) @db.Uuid
  itemId            String @db.Uuid
  item              Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  batchCode         String?
  expirationDate    DateTime?
  quantityReceived  Decimal @default("0") @db.Decimal(14, 4)
  quantityAvailable Decimal @default("0") @db.Decimal(14, 4)
  unitCost          Decimal? @db.Decimal(14, 4)
  status            BatchStatus @default(OPEN)

  // Soft delete
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime? @db.Timestamptz
  deletedByUserId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  inventory    InventoryEntry[]
  movements    StockMovement[]
  itemRequests ItemRequest[]

  @@index([itemId])
  @@index([expirationDate])
  @@index([status])
}

//////////////////////////////////////////////////////
// INVENTORY
//////////////////////////////////////////////////////

model InventoryEntry {
  id              String @id @default(uuid()) @db.Uuid

  /// Chave lógica única montada pela aplicação:
  /// itemId:facilityId:locationId|NULL:batchId|NULL
  balanceKey      String @unique

  itemId          String @db.Uuid
  facilityId      String @db.Uuid
  locationId      String? @db.Uuid
  batchId         String? @db.Uuid

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  location  Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batch     Batch?    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  minQuantity     Decimal? @db.Decimal(14,4)
  maxQuantity     Decimal? @db.Decimal(14,4)
  reorderPoint    Decimal? @db.Decimal(14,4)
  reorderQuantity Decimal? @db.Decimal(14,4)
  
  quantityOnHand   Decimal @default("0") @db.Decimal(14, 4)
  quantityReserved Decimal @default("0") @db.Decimal(14, 4)

  lastTransactionAt DateTime? @db.Timestamptz

  // Soft delete
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime? @db.Timestamptz
  deletedByUserId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([itemId])
  @@index([facilityId])
  @@index([locationId])
  @@index([batchId])
  @@index([itemId, facilityId])
}

//////////////////////////////////////////////////////
// MOVEMENTS (LEDGER)
//////////////////////////////////////////////////////

model StockMovement {
  id           String       @id @default(uuid()) @db.Uuid
  movementType MovementType

  referenceId  String?      @db.Uuid
  itemRequestId String?     @db.Uuid

  itemId     String @db.Uuid
  facilityId String @db.Uuid
  locationId String? @db.Uuid
  batchId    String? @db.Uuid

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  location  Location?  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batch     Batch?    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  request   ItemRequest? @relation(fields: [itemRequestId], references: [id], onDelete: SetNull)

  quantity    Decimal  @db.Decimal(14, 4)
  unitCost    Decimal? @db.Decimal(14, 4)
  performedByUserId String? @db.Uuid
  performedByUser   User?   @relation("StockMovementPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)
  performedAt DateTime @default(now()) @db.Timestamptz
  notes       String?

  @@index([itemId, facilityId, performedAt])
  @@index([batchId])
  @@index([locationId])
  @@index([itemRequestId])
}

//////////////////////////////////////////////////////
// MATERIALIZED VIEW (READ MODEL)
//////////////////////////////////////////////////////

model VwStockBalance {
  id         String  @id
  balanceKey String
  itemId     String  @db.Uuid
  facilityId String  @db.Uuid
  locationId String? @db.Uuid
  batchId    String? @db.Uuid
  qty        Decimal @db.Decimal(14, 4)

  @@map("vw_stock_balance_mat")
}

//////////////////////////////////////////////////////
// REQUESTS
//////////////////////////////////////////////////////

model ItemRequest {
  id              String @id @default(uuid()) @db.Uuid

  facilityId      String @db.Uuid
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  locationId      String? @db.Uuid
  location        Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  itemId          String @db.Uuid
  item            Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantityNeeded   Decimal @db.Decimal(14, 4)
  quantityCurrent  Decimal? @db.Decimal(14, 4)
  quantityProvided Decimal @default("0") @db.Decimal(14, 4)

  createdAt DateTime @default(now()) @db.Timestamptz

  requestType   RequestType   @default(REPLENISH)
  requestReason String?

  requestedByUserId String @db.Uuid
  requestedByUser   User   @relation("requests_made", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  statusCurrent     RequestStatus @default(PENDING)
  statusCurrentTime DateTime?     @db.Timestamptz

  justification String?

  batchId String? @db.Uuid
  batch   Batch?   @relation(fields: [batchId], references: [id], onDelete: Restrict)

  movementResponsibleUserId String? @db.Uuid
  movementResponsibleUser   User?   @relation("requests_responsible", fields: [movementResponsibleUserId], references: [id], onDelete: SetNull)

  time DateTime @default(now()) @db.Timestamptz

  statusHistory ItemRequestStatusHistory[]
  stockMovements StockMovement[]   // <- adicionar aqui

  @@index([facilityId])
  @@index([requestedByUserId])
  @@index([itemId])
  @@index([locationId])
  @@index([statusCurrent])
}

model ItemRequestStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  requestId String @db.Uuid
  request   ItemRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  previousStatus RequestStatus?
  newStatus      RequestStatus

  changedByUserId String? @db.Uuid
  changedByUser   User?   @relation("request_status_changed_by", fields: [changedByUserId], references: [id], onDelete: SetNull)

  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([requestId])
  @@index([newStatus])
  @@index([createdAt])
}